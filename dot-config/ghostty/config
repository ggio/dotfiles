# ======= Comments ======= #

# Run `ghostty +show-config --default --docs` to view a list of
# all available config options and their default values.

# Themes: `ghostty +list-themes`

# ======= Configs ======= #

theme = "Gruvbox Dark"
# theme = "Everforest Dark Hard"
# theme = "Gruvbox Material Dark"
window-colorspace = "display-p3"

font-family = BerkeleyMono Nerd Font

window-save-state = always

# Cursor
shell-integration-features = no-cursor
cursor-style = block
cursor-style-blink = false
cursor-color = #D8D6D1
cursor-text = #002121
cursor-opacity = 0.75

# ======= Keybindings ======= #

# New splits
keybind = ctrl+shift+j=new_split:down
keybind = ctrl+shift+l=new_split:right

# Go to splits
keybind = ctrl+alt+h=goto_split:left
keybind = ctrl+alt+j=goto_split:bottom
keybind = ctrl+alt+k=goto_split:top
keybind = ctrl+alt+l=goto_split:right

# Close splits
keybind = ctrl+q=close_surface
